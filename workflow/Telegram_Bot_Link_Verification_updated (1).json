    {
      "parameters": {
        "jsCode": "const text = $input.first().json.message.text || '';\n\nconst emailMatch = text.match(/Email:\\s*([^\\s\\n]+@[^\\s\\n]+)/i);\nconst email = emailMatch ? emailMatch[1].trim() : '';\n\nconst keywordMatch = text.match(/\\(keyword:\\s*([^\\)]+)\\)/i);\nconst keyword = keywordMatch ? keywordMatch[1].trim().toLowerCase() : '';\n\nlet packageName = '';\n\nconst paketMatch = text.match(/(?:🎫\\s*)?Paket:\\s*([^\\n]+)/i);\nif (paketMatch) {\n    packageName = paketMatch[1]\n        .replace(/\\(keyword:[^\\)]+\\)/i, '')\n        .trim();\n}\n\nif (!packageName) {\n    const yesplisMatch = text.match(/Tiket Type:\\s*([^\\n]+)/i);\n    if (yesplisMatch) packageName = yesplisMatch[1].trim();\n}\n\nif (!packageName) {\n    const loketMatch = text.match(/Type Ticket:\\s*([^\\n]+)/i);\n    if (loketMatch) packageName = loketMatch[1].trim();\n}\n\nif (!packageName) {\n    // Goers: \"Tiket: VIP\"\n    const goersMatch = text.match(/(?:^|\\n)Tiket:\\s*([^\\n]+)/i);\n    if (goersMatch) packageName = goersMatch[1].trim();\n}\n\nif (!packageName) {\n    // Fasticket: \"🎫 Ticket: VIP\"\n    const fasticketMatch = text.match(/(?:🎫\\s*)?Ticket:\\s*([^\\n]+)/i);\n    if (fasticketMatch) packageName = fasticketMatch[1].trim();\n}\n\nlet platform = 'unknown';\n\nif (\n    text.includes('TIKET ORDER BERHASIL') ||\n    text.includes('TIKET BERHASIL DIPESAN')\n) {\n    platform = 'tiketcom';\n}\nelse if (text.includes('LOKET PAYMENT BERHASIL')) {\n    platform = 'loket';\n}\nelse if (text.includes('CHECKOUT COMPLETE')) {\n    platform = 'yesplis';\n}\nelse if (text.includes('GOERS ORDER BERHASIL')) {\n    platform = 'goers';\n}\nelse if (text.includes('Fasticket Order Success')) {\n    platform = 'fasticket';\n}\n\nreturn [{\n    json:{\n        email,\n        keyword,\n        package_name:packageName,\n        platform,\n        raw_report:text\n    }\n}];"
      },
