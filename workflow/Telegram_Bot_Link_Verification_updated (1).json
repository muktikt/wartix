      "parameters": {
        "jsCode": "const text = $input.first().json.message.text || '';\nconst parts = text.split(' ');\nconst token = parts.length > 1 ? parts[1].trim() : '';\n\nconst chatId = $input.first().json.message.chat.id;\nconst telegramUserId = $input.first().json.message.from.id;\nconst telegramUsername = $input.first().json.message.from.username || '';\n\nreturn [{\n  json: {\n    token: token,\n    chat_id: String(chatId),\n    telegram_user_id: String(telegramUserId),\n    telegram_username: telegramUsername\n  }\n}];"
      },
